#spotifybutton {
    border-radius: 9px;
    border: none;
    background: transparent;
}

#spotifyplayer {
    background-color: #121212;
    border-radius: 5px;
    border: none;
}

#coverart {
    border: none;
    border-radius: 5px;
    background: transparent;
}

#title {
    background: transparent;
}

#timelabel {
    background: transparent;
}

QSlider {
    background: transparent;
    height: 10px;
}

QSlider::groove:horizontal {
    background-color: rgba(51, 51, 51, 102);
    height: 4px;
    border: none;
    border-radius: 2px;
}

QSlider::handle:horizontal {
    background: #ffffff;
    width: 10px;
    height: 10px;
    border-radius: 5px;
    margin: -3px 0px;
    border: none;
}

QSlider::add-page:horizontal {
    background: rgba(51, 51, 51, 102);
    border: none;
    border-radius: 2px;
}

QSlider::sub-page:horizontal {
    background: #ffffff;
    border: none;
    border-radius: 2px;
}
